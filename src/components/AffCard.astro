---
/**
 * カード型（1件）。記事の途中や末尾に置く用。
 * 使い方（.mdx）: <AffCard id="oisix-otameshi" />
 * frontmatter運用の場合は blog/[slug].astro が記事末尾で自動的に呼びます。
 */
import type { ResolvedAff } from '../lib/affiliates';
import { resolveAff } from '../lib/affiliates';

interface Props {
  id?: string;
  /** 解決済みオブジェクトを直接渡す用 */
  aff?: ResolvedAff;
}

const { id, aff: passed } = Astro.props;
const aff = passed ?? (id ? resolveAff(id) : null);
const trackId = id ?? aff?.label ?? '';
---

{
  aff && aff.found && aff.href && aff.banner && (
    <div class="aff-card aff-card--banner">
      <a href={aff.href} rel={aff.rel} target="_blank" data-aff-id={trackId} data-aff-label={aff.label}>
        <img
          src={aff.banner.src}
          width={aff.banner.width}
          height={aff.banner.height}
          alt={aff.label}
          loading="lazy"
        />
      </a>
      {aff.banner.impressionPixel && (
        <img class="aff-card__pixel" src={aff.banner.impressionPixel} width="1" height="1" loading="lazy" alt="" />
      )}
    </div>
  )
}

{
  aff && aff.found && !aff.banner && (
    <div class="aff-card">
      <div class="aff-card__body">
        <p class="aff-card__label">{aff.label}</p>
        {aff.desc && <p class="aff-card__desc">{aff.desc}</p>}
      </div>

      {aff.href ? (
        <a class="aff-card__cta" href={aff.href} rel={aff.rel} target="_blank" data-aff-id={trackId} data-aff-label={aff.label}>
          くわしく見る
        </a>
      ) : (
        <p class="aff-card__ended">現在このリンクは案内できません</p>
      )}
    </div>
  )
}

<script>
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest('[data-aff-id]') as HTMLAnchorElement | null;
    if (!link) return;
    const affId = link.dataset.affId ?? '';
    const affLabel = link.dataset.affLabel ?? '';
    const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
    if (typeof gtag === 'function') {
      gtag('event', 'aff_click', { aff_id: affId, aff_label: affLabel });
    }
  });
</script>

<style>
  .aff-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-block: 1.75rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--aff-border, rgba(0, 0, 0, 0.14));
    border-radius: var(--aff-radius, 4px);
    background: var(--aff-bg, transparent);
  }

  .aff-card__label {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .aff-card__desc {
    margin: 0.4rem 0 0;
    font-size: 0.86rem;
    line-height: 1.75;
    opacity: 0.75;
  }

  .aff-card__cta {
    align-self: flex-start;
    padding: 0.5rem 1.2rem;
    border: 1px solid currentColor;
    border-radius: var(--aff-radius, 4px);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }

  .aff-card__cta:hover {
    opacity: 0.65;
  }

  .aff-card__ended {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.5;
  }

  .aff-card--banner {
    align-items: center;
    padding: 0;
    border: none;
    background: none;
  }

  .aff-card--banner img {
    max-width: 100%;
    height: auto;
    border-radius: var(--aff-radius, 4px);
  }

  .aff-card__pixel {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .aff-card__cta {
      transition: none;
    }
  }
</style>
