---
/**
 * カード型（1件）。記事の途中や末尾に置く用。
 * 使い方（.mdx）: <AffCard id="oisix-otameshi" />
 * frontmatter運用の場合は blog/[slug].astro が記事末尾で自動的に呼びます。
 */
import type { ResolvedAff } from '../lib/affiliates';
import { resolveAff } from '../lib/affiliates';

interface Props {
  id?: string;
  /** 解決済みオブジェクトを直接渡す用 */
  aff?: ResolvedAff;
}

const { id, aff: passed } = Astro.props;
const aff = passed ?? (id ? resolveAff(id) : null);
---

{
  aff && aff.found && (
    <div class="aff-card">
      <div class="aff-card__body">
        <p class="aff-card__label">{aff.label}</p>
        {aff.desc && <p class="aff-card__desc">{aff.desc}</p>}
      </div>

      {aff.href ? (
        <a class="aff-card__cta" href={aff.href} rel={aff.rel} target="_blank">
          くわしく見る
        </a>
      ) : (
        <p class="aff-card__ended">現在このリンクは案内できません</p>
      )}
    </div>
  )
}

<style>
  .aff-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-block: 1.75rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--aff-border, rgba(0, 0, 0, 0.14));
    border-radius: var(--aff-radius, 4px);
    background: var(--aff-bg, transparent);
  }

  .aff-card__label {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .aff-card__desc {
    margin: 0.4rem 0 0;
    font-size: 0.86rem;
    line-height: 1.75;
    opacity: 0.75;
  }

  .aff-card__cta {
    align-self: flex-start;
    padding: 0.5rem 1.2rem;
    border: 1px solid currentColor;
    border-radius: var(--aff-radius, 4px);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }

  .aff-card__cta:hover {
    opacity: 0.65;
  }

  .aff-card__ended {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .aff-card__cta {
      transition: none;
    }
  }
</style>
